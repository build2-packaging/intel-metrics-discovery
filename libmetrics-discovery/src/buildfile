intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
#import xxxx_libs += libhello%lib{hello}

lib{metrics-discovery}: {hxx h cxx c}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/src/
src_pfx = [dir_path] $src_root/src/

cc.poptions =+ "-I$out_pfx" "-I$src_pfx"

#obja{*}: cc.poptions += -DLIBMETRICS_DISCOVERY_STATIC_BUILD
#objs{*}: cc.poptions += -DLIBMETRICS_DISCOVERY_SHARED_BUILD

# Export options.
#
lib{metrics-discovery}:
{
  cc.export.poptions = "-I$out_pfx" "-I$src_pfx"
  cc.export.libs = $intf_libs
}

#liba{metrics-discovery}: cc.export.poptions += -DLIBMETRICS_DISCOVERY_STATIC
#libs{metrics-discovery}: cc.export.poptions += -DLIBMETRICS_DISCOVERY_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{metrics-discovery}: bin.lib.version = "-$version.project_id"
else
  lib{metrics-discovery}: bin.lib.version = "-$version.major.$version.minor"

# Install recreating subdirectories.
#
{hxx h}{*}:
{
  install         = include/
  install.subdirs = true
}
